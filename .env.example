# ==========================================================
# Copie este arquivo para ".env.local" e preencha o que quiser usar.
#
# O site não tem mais banco de dados, gateway de pagamento nem envio de
# e-mail: o visitante simula o pedido na página e a conversa segue no
# WhatsApp. Por isso sobraram pouquíssimas variáveis, e TODAS são
# opcionais — sem nenhuma delas o site sobe e funciona igual.
# ==========================================================

# ----- Contato comercial -----
# Precisa do prefixo NEXT_PUBLIC_ para chegar ao navegador: é daqui que sai
# o número do botão "Prosseguir no WhatsApp". Só números, com DDI + DDD.
# Sem isso, o site usa o número de fallback que está no código.
NEXT_PUBLIC_WHATSAPP_TELEFONE="5562998119850"
NEXT_PUBLIC_WHATSAPP_RESPONSAVEL="Paulo Kamilo"

# ----- Endereço público do site -----
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================================
# MEDIÇÃO (opcional)
# As tags só carregam depois que o visitante aceita no banner de cookies.
# Deixando em branco, nenhum script de terceiro entra na página.
# ==========================================================

# Google Analytics 4 — id da stream, formato G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=""

# Meta Pixel (Instagram/Facebook) — só números
NEXT_PUBLIC_META_PIXEL_ID=""
